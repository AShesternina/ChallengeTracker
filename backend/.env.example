DATABASE_URL=postgresql+asyncpg://ct_user:ct_pass@localhost:5432/challengetracker
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# VAPID keys for Web Push (generate with: python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key, v.private_key)")
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_MAILTO=mailto:admin@example.com

# SendGrid (leave empty to use mock adapter)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=ChallengeTracker

APP_ENV=development
FRONTEND_URL=http://localhost:5173
